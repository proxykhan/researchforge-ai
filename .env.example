# Application
APP_ENV=development
APP_NAME=researchforge-ai
APP_LOG_LEVEL=INFO

# LLM Provider
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchforge

# Redis
REDIS_URL=redis://localhost:6379/0

# Research APIs
SEMANTIC_SCHOLAR_API_KEY=

# AWS (production)
AWS_REGION=
AWS_S3_BUCKET=
