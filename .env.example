# ResearchForge AI — environment variables
# Copy to .env and fill in real values:  cp .env.example .env
#
# When running via Docker Compose, service hostnames (postgres, redis)
# resolve automatically.  When running locally without Docker, use localhost.

# Application
APP_ENV=development
APP_NAME=researchforge-ai
APP_LOG_LEVEL=INFO
AUTH_ENABLED=false

# LLM Provider
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Database (Docker Compose hostnames)
DATABASE_URL=postgresql+asyncpg://researchforge:researchforge@postgres:5432/researchforge

# Redis
REDIS_URL=redis://redis:6379/0

# Research APIs
SEMANTIC_SCHOLAR_API_KEY=

# AWS (production)
AWS_REGION=
AWS_S3_BUCKET=
